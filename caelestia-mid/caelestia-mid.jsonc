{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json", // Optional: Provides IDE intelligence
  "logo": {
    "source": "~/.config/fastfetch/caelestia-mid/fastfetch_logo-mid.txt",
    "type": "auto",
    "padding": {
      "top": 1,
    },
  },
  "display": {
    "color": {
      "separator": "blue",
    },
    "separator": " ",
    "constants": ["|----------------------------------------------|"],
    "constants": ["└----------------------------------------------┘"],
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " {$USER} on",
      "keyColor": "magenta",
      "format": "{pretty-name}",
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator",
    },
    {
      "type": "kernel",
      "key": " Kernel ~~>",
    },
    {
      "type": "uptime",
      "key": " Uptime ~~>",
    },
    {
      "type": "disk",
      "key": " OS Age ~~>",
      "folders": "/",
      "format": "{days} days ({create-time:10})",
    },
    {
      "type": "shell",
      "key": " Shell  ~~>",
    },
    {
      "type": "custom",
      "format": "{$1}",
      "outputColor": "separator",
    },
    {
      "type": "cpu",
      "key": " CPU    ~~>",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "key": " GPU    ~~>",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": " RAM    ~~>",
      "format": "{used} -/- {total}",
    },
    {
      "type": "disk",
      "key": " Disk   ~~>",
      "format": "{size-used} -/- {size-total} | {filesystem}",
    },
    {
      "type": "custom",
      "format": "{$2}",
      "outputColor": "separator",
    },
  ],
}
